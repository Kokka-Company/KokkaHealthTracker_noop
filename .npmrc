# The Kokka design system is a private package on GitHub Packages.
# Point the @kokka-company scope at GitHub and read the token from the
# environment — never write the token itself into this file.
#
# Local install needs a CLASSIC PAT with `read:packages`; fine-grained tokens
# do not work against npm.pkg.github.com. Export it before installing:
#
#   export NODE_AUTH_TOKEN=ghp_xxxxxxxx
#   npm install
#
@kokka-company:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
