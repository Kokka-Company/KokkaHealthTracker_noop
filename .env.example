# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Base URL of this app. Must match the redirect URIs registered with each
# provider below.
APP_URL="http://localhost:3000"

# Local SQLite database.
DATABASE_URL="file:./dev.db"

# 32-byte key (base64) used to encrypt OAuth tokens at rest.
# Generate one with:  openssl rand -base64 32
ENCRYPTION_KEY=""

# Secret used to sign the session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# WHOOP  --  https://developer.whoop.com  ->  create an app
# Redirect URI to register: http://localhost:3000/api/auth/whoop/callback
# ---------------------------------------------------------------------------
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Microsoft 365 / Outlook Calendar
# https://portal.azure.com -> Entra ID -> App registrations -> New registration
# Redirect URI (Web) to register: http://localhost:3000/api/auth/microsoft/callback
# Delegated permissions needed: Calendars.Read, User.Read, offline_access
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" works for most accounts; use your tenant GUID to lock it to one org.
MICROSOFT_TENANT_ID="common"
