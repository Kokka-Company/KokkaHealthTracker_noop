{
  "name": "kokka-health-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source dashboard that integrates WHOOP and your calendar into a daily health outlook.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/copy-brand-assets.mjs && next build",
    "brand:sync": "node scripts/copy-brand-assets.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-brand-assets.mjs"
  },
  "dependencies": {
    "@kokka-company/design": "^1.0.0",
    "@prisma/client": "^6.2.1",
    "clsx": "^2.1.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true
  }
}
